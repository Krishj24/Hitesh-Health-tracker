# Copy to .env.local for local development. On Vercel these are set in
# Project Settings -> Environment Variables.

# Injected automatically when you attach a Neon Postgres database in Vercel.
# Locally, paste the connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Timezone the dates and times are recorded in. Defaults to Asia/Kolkata.
NEXT_PUBLIC_APP_TZ=Asia/Kolkata

# Optional. Leave unset and the app is open to anyone with the link.
# Set it to require a shared code before anything is visible.
# APP_PIN=4821
